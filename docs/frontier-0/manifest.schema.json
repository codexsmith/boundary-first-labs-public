{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boundary First Labs Public Frontier-0 Manifest v0.1",
  "description": "A downstream public presentation index; not a source-owner register, scientific claim status or publication authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "as_of",
    "lifecycle",
    "scope",
    "source_posture",
    "authority",
    "temporal_policy",
    "public_nodes",
    "facet_coverage",
    "navigation_edges",
    "research_relation_candidates",
    "confirmed_public_releases",
    "next_frontier",
    "publication_review",
    "recovery_cohorts",
    "recovery_event_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "lifecycle": {
      "const": "candidate_public_projection"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "source_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "completeness",
        "private_canonical_sources_reviewed_exhaustively",
        "chatgpt_conversation_url",
        "conversation_locator_public_disclosure",
        "rights_policy",
        "publication_policy",
        "provenance_policy"
      ],
      "properties": {
        "source_class": {
          "type": "string"
        },
        "completeness": {
          "type": "string"
        },
        "private_canonical_sources_reviewed_exhaustively": {
          "const": false
        },
        "chatgpt_conversation_url": {
          "type": "null"
        },
        "conversation_locator_public_disclosure": {
          "type": "string"
        },
        "rights_policy": {
          "type": "string"
        },
        "publication_policy": {
          "type": "string"
        },
        "provenance_policy": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_projection_only",
        "may_promote_research_claims",
        "may_grant_license",
        "may_trigger_external_actions",
        "private_lab_remains_source_authority"
      ],
      "properties": {
        "public_projection_only": {
          "const": true
        },
        "may_promote_research_claims": {
          "const": false
        },
        "may_grant_license": {
          "const": false
        },
        "may_trigger_external_actions": {
          "const": false
        },
        "private_lab_remains_source_authority": {
          "const": true
        }
      }
    },
    "temporal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontier_zero_type",
        "recovery_direction",
        "traversal",
        "date_priority",
        "dates_recorded_separately",
        "unknown_date_handling",
        "targeted_older_evidence_exception",
        "window_selection"
      ],
      "properties": {
        "frontier_zero_type": {
          "const": "versioned_contemporary_baseline"
        },
        "recovery_direction": {
          "const": "reverse_chronological"
        },
        "traversal": {
          "const": "breadth_first_across_eight_facets"
        },
        "date_priority": {
          "type": "string"
        },
        "dates_recorded_separately": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "unknown_date_handling": {
          "type": "string"
        },
        "targeted_older_evidence_exception": {
          "type": "string"
        },
        "window_selection": {
          "type": "string"
        }
      }
    },
    "public_nodes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "facet_coverage": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/facet"
      }
    },
    "navigation_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nav_edge"
      }
    },
    "research_relation_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/research_edge"
      }
    },
    "confirmed_public_releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    },
    "next_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontier_id",
        "lifecycle",
        "chronological_bounds",
        "facet_visit_count",
        "required_facet_visits",
        "advancement_rule",
        "next_action",
        "visit_completion",
        "founder_review_status"
      ],
      "properties": {
        "frontier_id": {
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "not_started",
            "first_pass_review_pending"
          ]
        },
        "chronological_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "status"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            },
            "status": {
              "const": "provisional_source_creation_window"
            }
          }
        },
        "facet_visit_count": {
          "type": "integer"
        },
        "required_facet_visits": {
          "const": 8
        },
        "advancement_rule": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "visit_completion": {
          "enum": [
            "not_started",
            "eight_documented_first_pass_outcomes_not_source_complete"
          ]
        },
        "founder_review_status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        }
      }
    },
    "publication_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "overall_status",
        "default_disposition",
        "require_explicit_approval_for_new_public_release",
        "board_path",
        "existing_releases_unaffected",
        "codexware_source_handling",
        "scientific_claim_and_rights_gates_separate"
      ],
      "properties": {
        "mode": {
          "const": "founder_high_level_prepublication"
        },
        "overall_status": {
          "enum": [
            "pending",
            "in_review",
            "reviewed"
          ]
        },
        "default_disposition": {
          "const": "hold"
        },
        "require_explicit_approval_for_new_public_release": {
          "const": true
        },
        "board_path": {
          "type": "string"
        },
        "existing_releases_unaffected": {
          "const": true
        },
        "codexware_source_handling": {
          "const": "founder_deferred_nonblocking"
        },
        "scientific_claim_and_rights_gates_separate": {
          "const": true
        }
      }
    },
    "recovery_cohorts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/recovery_cohort"
      }
    },
    "recovery_event_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recovery_event_candidate"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_kind",
        "title",
        "public_path",
        "lifecycle"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_kind": {
          "enum": [
            "public_method_exposition",
            "recovery_protocol",
            "released_educational_project",
            "presentation_facet",
            "presentation_highlight"
          ]
        },
        "title": {
          "type": "string"
        },
        "public_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "claim_ceiling": {
          "type": "string"
        }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet_id",
        "label",
        "presentation_role",
        "current_state",
        "coverage_state",
        "basis",
        "public_refs",
        "released_object_refs",
        "candidate_demo",
        "release_observation",
        "open_gaps",
        "founder_review_status",
        "publication_disposition",
        "w1_first_pass_status",
        "w2_first_pass_status",
        "w2_source_origin_evidence",
        "w2_first_pass_note",
        "w3_first_pass_status",
        "w3_source_origin_evidence",
        "w3_first_pass_note"
      ],
      "properties": {
        "facet_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string"
        },
        "presentation_role": {
          "type": "string"
        },
        "current_state": {
          "type": "string"
        },
        "coverage_state": {
          "enum": [
            "seed_only",
            "selected_public_release_verified"
          ]
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "public_release_manifest",
              "public_repository_navigation",
              "founder_visible_conversation",
              "bounded_private_canonical_source_read"
            ]
          },
          "uniqueItems": true
        },
        "public_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "released_object_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_demo": {
          "type": "string"
        },
        "release_observation": {
          "type": "string"
        },
        "open_gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "subprogram_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^highlight-[a-z0-9-]+$"
          }
        },
        "founder_review_status": {
          "enum": [
            "pending",
            "deferred",
            "reviewed"
          ]
        },
        "publication_disposition": {
          "enum": [
            "hold",
            "include_candidate",
            "revise",
            "exclude"
          ]
        },
        "w1_first_pass_status": {
          "enum": [
            "deferred_user_source_pending",
            "initial_owner_source_visited"
          ]
        },
        "w2_first_pass_status": {
          "enum": [
            "founder_deferred_nonblocking",
            "bounded_owner_visit"
          ]
        },
        "w2_source_origin_evidence": {
          "enum": [
            "not_observed_in_bounded_sample",
            "selected_source_within_window",
            "date_boundary_predecessor_only",
            "related_source_only"
          ]
        },
        "w2_first_pass_note": {
          "type": "string",
          "minLength": 15
        },
        "w3_first_pass_status": {
          "enum": [
            "founder_deferred_nonblocking",
            "bounded_cross_facet_review"
          ]
        },
        "w3_source_origin_evidence": {
          "enum": [
            "not_observed_in_bounded_sample",
            "adjacent_source_only",
            "date_boundary_predecessor_only",
            "source_within_window"
          ]
        },
        "w3_first_pass_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "nav_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation",
        "claim_effect"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "navigation_groups",
            "links_to_public_release",
            "references_current_method"
          ]
        },
        "claim_effect": {
          "const": "none"
        }
      }
    },
    "research_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "precedes",
            "refines",
            "supersedes",
            "renames",
            "generalizes",
            "specializes",
            "supports",
            "challenges",
            "implements",
            "illustrates",
            "candidate_correspondence"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "owner_reviewed"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "release_id",
        "release_manifest",
        "claim_ceiling",
        "status",
        "independently_reviewed",
        "executable_public_service"
      ],
      "properties": {
        "object_ref": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "release_manifest": {
          "type": "string"
        },
        "claim_ceiling": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "independently_reviewed": {
          "type": "boolean"
        },
        "executable_public_service": {
          "type": "boolean"
        }
      }
    },
    "recovery_cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "facet_outcomes",
        "original_source_audits_complete",
        "scope",
        "publication_decisions",
        "founder_review",
        "source_universe_exhausted",
        "report_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "facet_outcomes": {
          "type": "integer"
        },
        "original_source_audits_complete": {
          "type": "integer"
        },
        "scope": {
          "const": "bounded_first_pass"
        },
        "publication_decisions": {
          "const": "all_new_on_hold"
        },
        "founder_review": {
          "enum": [
            "pending",
            "in_review",
            "reviewed"
          ]
        },
        "source_universe_exhausted": {
          "const": false
        },
        "report_path": {
          "type": "string"
        }
      }
    },
    "recovery_event_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "title",
        "facet_id",
        "owner_source_date",
        "observed_commit_date",
        "source_role",
        "candidate_highlight",
        "claim_ceiling",
        "verification_state",
        "source_date_basis",
        "founder_review_status",
        "publication_disposition",
        "public_source_bytes",
        "source_completeness",
        "independently_verified_in_this_survey"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^w3-[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "facet_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "owner_source_date": {
          "type": "string",
          "format": "date"
        },
        "observed_commit_date": {
          "type": "string",
          "format": "date"
        },
        "source_role": {
          "type": "string",
          "minLength": 5
        },
        "candidate_highlight": {
          "type": "string",
          "minLength": 20
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 20
        },
        "verification_state": {
          "type": "string",
          "minLength": 5
        },
        "source_date_basis": {
          "const": "owner_recorded_not_independently_audited"
        },
        "founder_review_status": {
          "const": "pending"
        },
        "publication_disposition": {
          "const": "hold"
        },
        "public_source_bytes": {
          "const": "not_included"
        },
        "source_completeness": {
          "const": "selected_owner_excerpt"
        },
        "independently_verified_in_this_survey": {
          "const": false
        }
      }
    }
  }
}
